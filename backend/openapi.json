    "/api/projects/{project_id}/score": {
      "get": {
        "tags": [
          "score"
        ],
        "summary": "Get Score",
        "description": "Stage 3(採譜)未実行なら404を返す。\n\n`async def` ではなく通常の `def` にする(`api/export.py`の`export_score`と\n同じ理由、#27-M2レビュー指摘): `ScoreService.read_score`はファイルI/Oを\n伴う同期処理であり、`async def`のままだとイベントループを直接ブロックし、\nSSEでのジョブ進捗配信など他の同時リクエストを止めてしまう。\n\n`response_model`に`domain.score.ScoreIR`を直接指定しない: そのネストする\n`TempoMapEntry`/`TimeSignatureEntry`が`api/schemas.py`(beatmap用)の同名\nクラスとOpenAPIコンポーネント名で衝突し、生成TSの型名が\n`app__api__schemas__TempoMapEntry`等へ改名されてしまう(#23-M2レビュー\n指摘)。M2のフロントエンドはこのエンドポイントの型付けを必要としない\n(設計書§11.5の完了条件外)ため、素の`dict`で返し衝突を避ける。",
        "operationId": "get_score_api_projects__project_id__score_get",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Score Api Projects  Project Id  Score Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{project_id}/export": {
      "post": {
        "tags": [
          "export"
        ],
        "summary": "Export Score",
        "description": "量子化(#25)+L0(#26)実行済みが前提。未実行なら404、不正なScore IRなら422を返す。\n\n`async def` ではなく通常の `def` にする(`api/media.py`の`get_peaks`と同じ\n理由、#27-M2レビュー指摘): `render_musicxml`/`render_midi`はCPUバウンドの\n同期処理(partitura呼び出し)であり、`async def`のままだとイベントループを\n直接ブロックし、SSEでのジョブ進捗配信など他の同時リクエストを止めてしまう。",
        "operationId": "export_score_api_projects__project_id__export_post",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExportRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/vnd.recordare.musicxml+xml": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "audio/midi": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BeatEntry": {
        "properties": {
          "time_sec": {
            "type": "number",
            "title": "Time Sec"
          },
          "beat_in_bar": {
            "type": "integer",
            "title": "Beat In Bar"
          },
          "bar": {
            "type": "integer",
            "title": "Bar"
          }
        },
        "type": "object",
        "required": [
          "time_sec",
          "beat_in_bar",
          "bar"
        ],
        "title": "BeatEntry"
      },
      "Beatmap": {
        "properties": {
          "beats": {
            "items": {
              "$ref": "#/components/schemas/BeatEntry"
            },
            "type": "array",
            "title": "Beats"
          },
          "downbeats_sec": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Downbeats Sec"
          },
          "time_signatures": {
            "items": {
              "$ref": "#/components/schemas/TimeSignatureEntry"
            },
            "type": "array",
            "title": "Time Signatures"
          },
          "tempo_map": {
            "items": {
              "$ref": "#/components/schemas/TempoMapEntry"
            },
            "type": "array",
            "title": "Tempo Map"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "default": "auto"
          }
        },
        "type": "object",
        "required": [
          "beats",
          "downbeats_sec",
          "time_signatures",
          "tempo_map",
          "confidence"
        ],
        "title": "Beatmap"
      },
      "BeatmapEditRequest": {
        "properties": {
          "offset_sec": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Offset Sec"
          },
          "bpm_override": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bpm Override"
          },
          "rotate_downbeat": {
            "type": "boolean",
            "title": "Rotate Downbeat",
            "default": false
          },
          "time_signature_override": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TimeSignatureEntry"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "BeatmapEditRequest",
        "description": "#20 BeatGridEditor: 送られたフィールドのみ順に適用する(オフセット→BPM→回転→拍子)。"
      },
      "Body_create_project_api_projects_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",

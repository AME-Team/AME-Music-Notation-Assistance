              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StemListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{project_id}/analysis/peaks/{name}": {
      "get": {
        "tags": [
          "media"
        ],
        "summary": "Get Peaks",
        "description": "#21: 波形ピークデータ。初回計算し `analysis/peaks/{name}.json` にキャッシュする。\n\n`async def` ではなく通常の `def` にする(#20-M1レビュー指摘の追加ラウンド)。\n初回計算時は `compute_peaks`(`sf.read` によるWAV全体の読み込み+numpy計算)を\n呼ぶため、`async def` のままだとイベントループを直接ブロックし、SSEでのジョブ\n進捗配信など他の同時リクエスト全体を止めてしまう(NFR-04の「重いDSPはWorker\nプロセスへ分離する」方針とも矛盾する)。FastAPIは同期`def`のエンドポイントを\n自動的にスレッドプールで実行するため、これだけでイベントループを塞がなくなる。",
        "operationId": "get_peaks_api_projects__project_id__analysis_peaks__name__get",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeaksResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
